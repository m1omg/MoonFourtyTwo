{
  "name": "este-jedno",
  "private": true,
  "version": "0.1.0",
  "description": "Ešte jedno – first-person horror adventure (web, three.js)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "assets:fetch": "node scripts/assets/fetch-assets.ts",
    "assets:build": "node scripts/assets/build-assets.ts",
    "assets:budget": "node scripts/assets/check-budgets.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "~0.186.1",
    "three-mesh-bvh": "0.9.15",
    "troika-three-text": "0.52.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "@types/three": "0.186.0",
    "eslint": "^10.1.0",
    "fflate": "0.8.3",
    "globals": "^17.13.0",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.8.1",
    "sharp": "0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
